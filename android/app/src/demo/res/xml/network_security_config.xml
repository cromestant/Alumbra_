<?xml version="1.0" encoding="utf-8"?>
<!-- Demo build: HTTPS only, with no cleartext exceptions for dev
     servers (src/main has the dev build's). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
