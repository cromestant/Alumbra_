<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/appname_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="ANSWER"
            android:textColor="@color/alumbra_dim"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Way back to the Ask screen: first control after the title,
             so it is reachable without scrolling past a long answer. -->
        <Button
            android:id="@+id/new_question_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/new_question_description"
            android:minHeight="56dp"
            android:text="@string/new_question_label"
            style="@style/Widget.Alumbra.Button.Outline" />

        <LinearLayout
            android:id="@+id/helpbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/box_help"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="@string/getting_help_title"
                android:textColor="@color/alumbra_help"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/help_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/alumbra_ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/help_waiting"
                android:textColor="@color/alumbra_dim"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/warnbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/box_warn"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/warn_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/alumbra_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/question_asked_description"
            android:textColor="@color/alumbra_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/answer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/alumbra_ink"
            android:textSize="24sp" />

        <ai.alumbra.app.FlowLayout
            android:id="@+id/saw_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:id="@+id/btnrow_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/answer_replay_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/replay_description"
                android:minHeight="60dp"
                android:text="@string/replay_label"
                style="@style/Widget.Alumbra.Button.Outline" />

            <Button
                android:id="@+id/follow_up_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/follow_up_description"
                android:minHeight="60dp"
                android:text="@string/follow_up_label"
                style="@style/Widget.Alumbra.Button.Primary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnrow_escalated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/keep_waiting_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/keep_waiting_description"
                android:minHeight="60dp"
                android:text="@string/keep_waiting_label"
                style="@style/Widget.Alumbra.Button.Outline" />

            <Button
                android:id="@+id/leave_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/leave_description"
                android:minHeight="60dp"
                android:text="@string/leave_label"
                style="@style/Widget.Alumbra.Button.Outline" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
