<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/appname_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="SETTINGS"
            android:textColor="@color/alumbra_dim"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.15"
            android:text="@string/section_speaking"
            android:textColor="@color/alumbra_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_language"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/language_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/settings_language_description" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_rate"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/rate_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings_rate_description"
            android:max="30" />

        <TextView
            android:id="@+id/rate_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/alumbra_amber"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/alumbra_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.15"
            android:text="@string/section_display"
            android:textColor="@color/alumbra_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/contrast_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/settings_contrast_description"
            android:text="@string/settings_contrast"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/alumbra_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.15"
            android:text="@string/section_service"
            android:textColor="@color/alumbra_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_server"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/base_url_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/box_type"
            android:contentDescription="@string/settings_server_description"
            android:hint="@string/settings_server_hint"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="@color/alumbra_ink"
            android:textColorHint="@color/alumbra_dim"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preset_lan_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/preset_lan_description"
                android:minHeight="0dp"
                android:text="@string/preset_lan_label"
                style="@style/Widget.Alumbra.Button.Slim" />

            <Button
                android:id="@+id/preset_tail_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/preset_tail_description"
                android:minHeight="0dp"
                android:text="@string/preset_tail_label"
                style="@style/Widget.Alumbra.Button.Slim" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:labelFor="@id/app_token_field"
            android:text="@string/settings_app_token"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <!-- Visible, not masked: TalkBack users need to hear what they
             typed. -->
        <EditText
            android:id="@+id/app_token_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/box_type"
            android:contentDescription="@string/settings_app_token_description"
            android:hint="@string/settings_app_token_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:padding="12dp"
            android:textColor="@color/alumbra_ink"
            android:textColorHint="@color/alumbra_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/save_server_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/save_server_description"
            android:minHeight="56dp"
            android:text="@string/save_server_label"
            style="@style/Widget.Alumbra.Button.Primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_camera_tier"
            android:textColor="@color/alumbra_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/camera_tier_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/alumbra_amber"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
