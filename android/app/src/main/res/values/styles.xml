<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Alumbra.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_amber</item>
        <item name="android:textColor">@color/alumbra_amber_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Alumbra.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/alumbra_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Alumbra.Button.Pill" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_pill_amber</item>
        <item name="android:textColor">@color/alumbra_amber</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Alumbra.Button.Slim" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/alumbra_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
