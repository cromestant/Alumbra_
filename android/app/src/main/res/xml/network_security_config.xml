<?xml version="1.0" encoding="utf-8"?>
<!-- DEV ONLY: the v1 backend runs on a LAN address over cleartext HTTP.
     Replace with a pinned HTTPS host before any non-dev use. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
