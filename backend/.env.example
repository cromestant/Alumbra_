# Alumbra backend environment. Every variable the server reads, by name.
# Copy to the REPO ROOT as .env (that is where the backend looks for
# secrets) and fill in. The systemd unit loads the same file with
# EnvironmentFile=, which is the only way the switches and tunables
# below reach the process: the server reads those from the process
# environment, while the keys and TTS_VOICE_PROFILE also fall back to
# reading .env directly.
# Empty means the default noted alongside.

# --- Keys (required) ---
META_MODEL_API_KEY=
BASETEN_API_KEY=
# The Jev intent gate (api.typesafe.ai)
JEV_API_KEY=
# Voxtral answer audio
MISTRAL_API_KEY=
# Volunteer console; empty turns escalation off
VOLUNTEER_TOKEN=
# Required on /ask and /followup as X-App-Token when set (empty: no
# check). Entered in the app's Settings, never compiled in.
APP_TOKEN=

# --- Server ---
# Port the systemd unit binds uvicorn to, on 127.0.0.1 (dev uses 8123)
ALUMBRA_PORT=
# Set to production to force captures off
ALUMBRA_ENV=
# Where captures go (default backend/captures)
CAPTURE_DIR=

# --- Kill switches (default on; 0 turns off) ---
# Stores personal photos (default on until a fixed date, then off;
# always off with ALUMBRA_ENV=production)
CAPTURE_ENABLED=
ESCALATION_ENABLED=
TTS_ENABLED=
JEV_GATE_ENABLED=
AUDIO_QUESTION_ENABLED=
SYNTHESIS_ENABLED=
BASETEN_ENABLED=
FLOOR_LOOK_ENABLED=
METRIC_DISTANCE_ENABLED=
# Per-stage timings in each ask's log line
STAGE_TIMES_ENABLED=

# --- Tunables ---
# Phone height in metres for ground distances
CAM_HEIGHT_M=
# How long an ask can take follow-ups, in seconds
ASK_TTL_S=
# How long an escalation waits for a volunteer (default 120)
ESCALATION_WINDOW_S=
# Parallel SAM calls
SAM_CONCURRENCY=
# Voice: sheila (default), paul or jane
TTS_VOICE_PROFILE=
# Model overrides
SPARK_MODEL=
BASETEN_SYNTH_MODEL=
META_MODEL_API_BASE=
